function bmi(weight, height) {
  let bmi = weight / (height * height) // calculate bmi based on codewars formula given
  if (bmi <= 18.5) {
    return "Underweight"
  } else if (bmi <= 25 && bmi > 18.5) {
    return "Normal"
  } else if (bmi <= 30 && bmi > 25) {
    return "Overweight"
  } else if (bmi > 30) {
    return "Obese"
    }
}